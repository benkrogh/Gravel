# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
RUN corepack enable
COPY package.json ./
COPY pnpm-lock.yaml* ./
COPY pnpm-workspace.yaml* ./
RUN --mount=type=cache,id=magnettic-pnpm-store,target=/root/.local/share/pnpm/store \
  if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi

FROM base AS builder
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV MAGNETTIC_BUILD=1
ENV NODE_ENV=production
RUN --mount=type=cache,id=magnettic-next-cache,target=/app/.next/cache \
  pnpm build \
  && mkdir -p /export \
  && if [ -f /app/.next/standalone/server.js ]; then \
       echo "Magnettic: using Next standalone (slim runtime)" \
       && cp -a /app/.next/standalone/. /export/ \
       && mkdir -p /export/.next \
       && cp -a /app/.next/static /export/.next/static \
       && if [ -d /app/public ]; then cp -a /app/public /export/public; fi \
       && printf '%s\n' '#!/bin/sh' 'set -e' 'exec node server.js' > /export/magnettic-start.sh \
       && chmod +x /export/magnettic-start.sh \
       && echo standalone > /export/.magnettic-runtime-mode; \
     else \
       echo "WARNING: .next/standalone missing after next build." \
       && echo "WARNING: Magnettic falling back to next start (heavier image)." \
       && echo "WARNING: Add output: \"standalone\" (or MAGNETTIC_BUILD env-gate) in next.config for faster previews." \
       && cp -a /app/package.json /export/ \
       && if [ -f /app/pnpm-lock.yaml ]; then cp -a /app/pnpm-lock.yaml /export/; fi \
       && if [ -f /app/pnpm-workspace.yaml ]; then cp -a /app/pnpm-workspace.yaml /export/; fi \
       && cp -a /app/node_modules /export/node_modules \
       && cp -a /app/.next /export/.next \
       && if [ -d /app/public ]; then cp -a /app/public /export/public; fi \
       && for f in next.config.mjs next.config.js next.config.ts next.config.cjs; do \
            if [ -f "/app/$f" ]; then cp -a "/app/$f" /export/; fi; \
          done \
       && printf '%s\n' '#!/bin/sh' 'set -e' 'exec ./node_modules/.bin/next start -H 0.0.0.0 -p 3000' > /export/magnettic-start.sh \
       && chmod +x /export/magnettic-start.sh \
       && echo heavy > /export/.magnettic-runtime-mode; \
     fi

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=builder /export /app
EXPOSE 3000
CMD ["./magnettic-start.sh"]
